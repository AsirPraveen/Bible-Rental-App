# Copy to .env and fill in. Names only here — never commit real values.

# ── Core ───────────────────────────────────────────────────────────────
MONGO_URL=
JWT_SECRET=
PORT=5001
NODE_ENV=development

# ── Google sign-in ─────────────────────────────────────────────────────
# Comma-separated OAuth client ids. Sign-in FAILS CLOSED without this:
# the server verifies every credential's `aud` against this list.
GOOGLE_CLIENT_IDS=

# ── Email (Gmail app password, not the account password) ───────────────
EMAIL_USER=
EMAIL_PASS=

# ── Cloudinary ─────────────────────────────────────────────────────────
# The secret signs uploads server-side. No unsigned preset is shipped in
# the app any more, so this must be set for uploads to work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Stability AI (verse illustrations) ─────────────────────────────────
# Proxied by POST /api/generate-verse-image. Never expose this to the app.
STABILITY_API_KEY=
STABILITY_API_URL=https://api.stability.ai/v1/generation/stable-diffusion-xl-1024-v1-0/text-to-image

# ── Optional ───────────────────────────────────────────────────────────
# Comma-separated origins allowed to open a socket. Leave blank for
# native-only builds; set it before shipping an Expo web build.
ALLOWED_ORIGINS=
APP_NAME=Youth Room

# One-off, used by scripts/migrate.js only.
OLD_MONGO_URL=
