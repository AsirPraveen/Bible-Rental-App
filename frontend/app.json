{
  "expo": {
    "name": "YOUTH ROOM",
    "slug": "YouthRoom",  
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/jesus-holding-bible.avif",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/jesus-holding-bible.avif",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/jesus-holding-bible.avif"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/jesus-holding-bible.avif",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "permissions": [
      "camera",
      "mediaLibrary"
    ]
  }
}
